---
// The Contact link is a plain fragment link: on the home page it scrolls (html
// has scroll-behavior: smooth), and from anywhere else it navigates home and
// lands on the contact block.
//
// The language switch is a link too: ES and EN always sit in that order, the
// current one in ink and the other one a link to this page in that language.
import { LANGS, UI, localizePath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
  /** This page in each language, or the closest page when there is no translation. */
  switchTo: Record<Lang, string>;
}

const { lang, switchTo } = Astro.props;
const t = UI[lang];
const home = localizePath('/', lang);
---

<nav class="fixed top-0 inset-x-0 z-50 bg-paper/95 backdrop-blur-sm border-b border-rule">
  <div class="max-w-[680px] mx-auto px-6 h-14 flex items-center justify-between gap-3">
    <a
      href={home}
      class="text-[15px] font-bold font-serif text-ink hover:text-accent transition-colors whitespace-nowrap"
    >
      Diego Said
    </a>

    <div class="flex items-center gap-2.5 sm:gap-6">
      <a
        href={localizePath('/blog/', lang)}
        class="text-[14px] font-serif text-muted hover:text-ink transition-colors"
      >
        {t.writing}
      </a>
      <a
        href={localizePath('/cv/', lang)}
        class="text-[14px] font-serif text-muted hover:text-ink transition-colors"
      >
        {t.cv}
      </a>
      <a
        href={`${home}#${t.contactId}`}
        class="text-[14px] font-serif text-muted hover:text-ink transition-colors"
      >
        {t.contact}
      </a>
      <div class="flex items-center gap-1.5 pl-2.5 sm:pl-6 border-l border-rule font-mono text-[13px]">
        {
          LANGS.map((code, i) => (
            <>
              {i > 0 && (
                <span class="text-muted/60" aria-hidden="true">
                  /
                </span>
              )}
              {code === lang ? (
                <span class="text-ink font-medium">
                  {code.toUpperCase()}
                </span>
              ) : (
                <a
                  href={switchTo[code]}
                  hreflang={code}
                  lang={code}
                  aria-label={UI[code].switchLabel}
                  class="text-muted hover:text-accent transition-colors"
                >
                  {code.toUpperCase()}
                </a>
              )}
            </>
          ))
        }
      </div>
    </div>
  </div>
</nav>

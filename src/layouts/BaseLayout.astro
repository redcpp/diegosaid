---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { DEFAULT_LANG, LANGS, OG_LOCALE, UI, localizePath, otherLang, type Lang } from '@/i18n';
// Self-hosted: the woff2 files ship from this domain with the rest of the build,
// so there is no third-party request before the first paint and no font
// stylesheet to wait on. Each file declares a unicode-range, so a page only
// downloads the subsets its text uses.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute path to the generated OG image for this route. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** schema.org blocks for this page, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** For ogType 'article': the facts Open Graph carries about a post. */
  article?: { published: Date; tags: string[] };
  /** Path of this page's plain Markdown version, when it has one. */
  markdown?: string;
  /** Language of the page, chrome included. */
  lang?: Lang;
  /**
   * This page's path in each language it exists in, this one included. Feeds
   * the hreflang links and the navbar switch.
   */
  alternates?: Partial<Record<Lang, string>>;
  /**
   * Where the switch leads when the page has no translation: a post not yet
   * written in the other language falls back to that language's /blog/.
   */
  fallback?: Partial<Record<Lang, string>>;
}

const {
  title,
  description,
  ogImage = '/og/index.png',
  ogType = 'website',
  jsonLd = [],
  article,
  markdown,
  lang = DEFAULT_LANG,
  alternates = {},
  fallback = {},
} = Astro.props;

const ogLocale = OG_LOCALE[lang];
const switchTo = Object.fromEntries(
  LANGS.map((code) => [code, alternates[code] ?? fallback[code] ?? localizePath('/', code)]),
) as Record<Lang, string>;
// Only real translations become hreflang links; a fallback is a different page.
const hreflangs = LANGS.filter((code) => alternates[code]).map((code) => ({
  code,
  href: new URL(alternates[code]!, Astro.site).href,
}));
// Spanish is the site's own language, so a reader in any third language lands there.
const xDefaultPath = alternates[DEFAULT_LANG];
const xDefault = xDefaultPath ? new URL(xDefaultPath, Astro.site).href : undefined;

// Keep the trailing slash: Cloudflare Pages 308-redirects /blog/adr47 to
// /blog/adr47/, and the sitemap emits the slashed form. Stripping it here would
// point the canonical at a URL that redirects to the canonical.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FCFCFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151518" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Diego Said — ${UI[lang].writing}`}
      href={localizePath('/rss.xml', lang)}
    />
    {
      hreflangs.length > 1 && (
        <>
          {hreflangs.map(({ code, href }) => (
            <link rel="alternate" hreflang={code} href={href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }

    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Diego Said" />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates[otherLang(lang)] && (
        <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />
      )
    }

    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:author" content={new URL(localizePath('/', lang), Astro.site).href} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLd.map((block) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    {/* Plausible Analytics */}
    <script is:inline defer data-domain="diegosaid.com" src="https://plausible.io/js/script.js"
    ></script>
  </head>
  <body>
    <div class="min-h-screen flex flex-col bg-paper">
      <Navbar lang={lang} switchTo={switchTo} />
      <main class="flex-1 pt-14">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

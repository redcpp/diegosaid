---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not Found — Diego Said"
  description="That page does not exist."
>
  <div class="max-w-[780px] mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <p class="text-[13px] font-mono text-muted">404</p>
    <h1 class="text-[28px] lg:text-[32px] font-bold tracking-tight mt-3">Not Found</h1>
    <p class="mt-3 text-[17px] text-muted leading-relaxed">
      That page does not exist.
    </p>
    <div class="mt-12 border-t border-rule pt-8 flex items-center gap-6">
      <a href="/" class="text-[14px] font-mono text-muted hover:text-accent transition-colors">
        ← Home
      </a>
      <a href="/blog" class="text-[14px] font-mono text-muted hover:text-accent transition-colors">
        Writing
      </a>
    </div>
  </div>
</BaseLayout>

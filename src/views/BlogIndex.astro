---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, isScheduled, localizePath, ogImagePath, postPath, UI, type Lang } from '@/i18n';
import { monthYear, readTime } from '@/lib/format';
import { tagClass } from '@/lib/tags';
import Star from '@/components/Star.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const posts = await getPosts(lang);
const featuredCount = posts.filter((post) => post.data.featured).length;

// The order switch is two radio buttons and a :has() rule, since the site ships
// no client JavaScript. The list is rendered once in each order and the rule
// hides one, rather than reversing a single list with CSS: a reversed flexbox
// would show one order and tab through the other.
const orders = [
  { key: 'newest', label: t.newest, posts, visibility: 'group-has-[#order-oldest:checked]/order:hidden' },
  {
    key: 'oldest',
    label: t.oldest,
    posts: [...posts].reverse(),
    visibility: 'hidden group-has-[#order-oldest:checked]/order:block',
  },
];
---

<BaseLayout
  title={`${t.writing} — Diego Said`}
  description={t.writingDescription}
  ogImage={ogImagePath('blog', lang)}
  lang={lang}
  alternates={{ en: '/blog/', es: '/es/blog/' }}
>
  <div class="max-w-[780px] mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <h1 class="text-[28px] lg:text-[32px] font-bold tracking-tight">{t.writing}</h1>
    <p class="mt-3 text-[17px] text-muted leading-relaxed">
      {t.writingDescription}
    </p>
    <a
      href={localizePath('/rss.xml', lang)}
      class="inline-block mt-4 font-mono text-[13px] text-muted hover:text-accent transition-colors"
    >
      RSS
    </a>

    <section class="mt-12 group/order" aria-labelledby="all-writing">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
        <h2 id="all-writing" class="text-[22px] font-bold">{t.allWriting}</h2>
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
          {featuredCount > 0 && (
            <p class="font-mono text-[13px] text-muted" aria-hidden="true">
              <Star /> {t.featured}
            </p>
          )}
          <fieldset class="flex gap-4 font-mono text-[13px]">
            <legend class="sr-only">{t.order}</legend>
            {
              orders.map(({ key, label }) => (
                <label class="cursor-pointer text-muted hover:text-accent transition-colors underline-offset-4 has-[:checked]:text-ink has-[:checked]:underline has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent">
                  <input
                    type="radio"
                    name="order"
                    id={`order-${key}`}
                    value={key}
                    checked={key === 'newest'}
                    class="sr-only"
                  />
                  {label}
                </label>
              ))
            }
          </fieldset>
        </div>
      </div>
      {
        orders.map(({ key, posts, visibility }) => (
          <ol data-order={key} class={`mt-6 border-t border-rule divide-y divide-rule ${visibility}`}>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)} class="block py-8 group">
                  <div class="flex items-baseline gap-3 text-[13px] font-mono text-muted">
                    <span>{monthYear(post.data.date, lang)}</span>
                    <span>·</span>
                    <span>{readTime(post.data.readMinutes)}</span>
                    {isScheduled(post) && (
                      <>
                        <span>·</span>
                        <span class="text-note">{t.scheduled}</span>
                      </>
                    )}
                  </div>
                  <h3 class="text-[20px] font-bold mt-2 group-hover:text-accent transition-colors">
                    {post.data.title}
                    {post.data.featured && (
                      <span class="ml-1 whitespace-nowrap" title={t.featured}>
                        <Star />
                        <span class="sr-only">({t.featured})</span>
                      </span>
                    )}
                  </h3>
                  <p class="text-[15px] text-muted mt-2 leading-relaxed">{post.data.excerpt}</p>
                  <div class="flex flex-wrap gap-2 mt-3">
                    {post.data.tags.map((tag, i) => (
                      <span class={`text-[12px] font-mono border px-2 py-0.5 rounded ${tagClass(i)}`}>
                        {tag}
                      </span>
                    ))}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        ))
      }
    </section>
  </div>
</BaseLayout>

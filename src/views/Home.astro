---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToptalBadge from '@/components/ToptalBadge.astro';
import { ogImagePath, type Lang } from '@/i18n';
import { CV } from '@/i18n/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = CV[lang];
---

<BaseLayout
  title="Diego Said Anaya Mancilla"
  description={cv.meta.description}
  ogImage={ogImagePath('index', lang)}
  personSchema
  lang={lang}
  alternates={{ en: '/', es: '/es/' }}
>
  <div class="max-w-[780px] mx-auto px-6 lg:px-8 pb-16">
    {/* 1. HEADER */}
    <header class="py-16 lg:py-24 text-center">
      <h1 class="text-[28px] lg:text-[32px] font-bold tracking-tight text-ink font-serif">
        Diego Said Anaya Mancilla
      </h1>
      <p class="text-[17px] text-muted mt-2 font-serif">{cv.role}</p>
      <p class="text-[14px] font-mono text-muted mt-6">{cv.location}</p>
      <p class="text-[14px] font-mono mt-1">
        {/* Cloudflare's Email Address Obfuscation rewrites mailto: links into a
            __cf_email__ span that needs JavaScript to decode, so the address is
            absent from the HTML a recruiter's scraper or an LLM screener reads.
            These markers opt the region out; they must stay HTML comments,
            because Cloudflare reads them from the response body. */}
        <!--email_off-->
        <a href="mailto:redcpp@gmail.com" class="text-accent">redcpp@gmail.com</a>
        <!--email_on-->
        <span class="text-muted"> &middot; </span>
        <a
          href="https://github.com/redcpp"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent">github.com/redcpp</a
        >
        <span class="text-muted"> &middot; </span>
        <a
          href="https://linkedin.com/in/redcpp"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent">linkedin.com/in/redcpp</a
        >
      </p>
    </header>

    {/* 2. ABOUT */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif">{cv.headings.about}</h2>
      <p class="mt-4 text-[17px] leading-[1.75] font-serif text-ink">
        {cv.about}
      </p>
    </section>

    {/* 3. EXPERIENCE */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-8">{cv.headings.experience}</h2>
      <div class="space-y-0">
        {
          cv.experience.map((entry) => (
            <div class="flex flex-col sm:flex-row sm:gap-8 py-6">
              <div class="w-[140px] shrink-0 font-mono text-[13px] text-muted">{entry.years}</div>
              <div class="mt-1 sm:mt-0">
                <p class="font-semibold font-serif text-ink">{entry.title}</p>
                <p class="italic text-muted text-[15px] mt-0.5 font-serif">{entry.org}</p>
                <p class="text-[15px] leading-[1.7] text-ink/85 mt-2 font-serif">
                  {entry.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* 4. OPEN SOURCE */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-8">{cv.headings.openSource}</h2>
      {
        cv.projects.map((project, i) => (
          <div class={i === 0 ? '' : 'mt-10'}>
            <p class="font-semibold text-[18px] font-serif text-ink">{project.title}</p>
            <p class="text-[15px] leading-[1.7] mt-2 font-serif text-ink">{project.description}</p>
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[14px] text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent mt-2 inline-block"
            >
              {project.link.replace('https://', '')}
            </a>
            {project.image && (
              <img
                src={project.image}
                alt={cv.screenshotAlt(project.title)}
                loading="lazy"
                decoding="async"
                class="rounded-lg border border-rule w-full mt-4"
              />
            )}
          </div>
        ))
      }
    </section>

    {/* 5. PUBLICATIONS */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-6">{cv.headings.publications}</h2>
      {
        cv.publications.map((entry) => (
          <p class="text-[15px] leading-[1.7] mb-4 font-serif text-ink flex gap-2">
            <span class="font-mono text-[13px] text-cite shrink-0 pt-0.5">{entry.ref}</span>
            <span set:html={entry.citation} />
          </p>
        ))
      }
    </section>

    {/* 6. EDUCATION */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-8">{cv.headings.education}</h2>
      <div class="space-y-0">
        {
          cv.education.map((entry) => (
            <div class="flex flex-col sm:flex-row sm:gap-8 py-6">
              <div class="w-[140px] shrink-0 font-mono text-[13px] text-muted">{entry.years}</div>
              <div class="mt-1 sm:mt-0">
                <p class="font-semibold font-serif text-ink">{entry.title}</p>
                <p class="italic text-muted text-[15px] mt-0.5 font-serif">{entry.org}</p>
                {entry.description && (
                  <p class="text-[15px] leading-[1.7] text-ink/85 mt-2 font-serif">
                    {entry.description}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* 7. HONORS */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-6">{cv.headings.honors}</h2>
      {cv.honors.map((honor) => <p class="text-[15px] leading-[1.7] font-serif text-ink">{honor}</p>)}
    </section>

    {/* 8. SKILLS */}
    <section class="border-t border-rule pt-12 mt-12">
      <h2 class="text-[22px] font-bold font-serif mb-6">{cv.headings.skills}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
        {
          cv.skills.map((cat) => (
            <div>
              <h3 class="text-[15px] font-semibold mb-1 font-serif">{cat.title}</h3>
              <p class="text-[15px] text-muted leading-relaxed font-serif">{cat.items}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-[15px] text-muted font-serif">{cv.spokenLanguages}</p>
    </section>

    {/* 9. CONTACT */}
    <section id="contact" class="border-t border-rule pt-12 mt-12 scroll-mt-20">
      <h2 class="text-[22px] font-bold font-serif mb-6">{cv.headings.contact}</h2>
      {/* The badge sets flush with the right margin, and the list's four lines
          spread to the badge's full height so both columns start and end
          together. */}
      <div class="flex flex-col sm:flex-row sm:justify-between gap-10 sm:gap-14">
        <div
          class="space-y-2 sm:space-y-0 sm:flex sm:flex-col sm:justify-between font-mono text-[15px]"
        >
          <p>
            {cv.contactLabels.email}: <!--email_off--><a
              href="mailto:redcpp@gmail.com"
              class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent"
              >redcpp@gmail.com</a
            ><!--email_on-->
          </p>
          <p class="text-ink">{cv.contactLabels.phone}: +1 720 331 5493</p>
          <p>
            GitHub: <a
              href="https://github.com/redcpp"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent"
              >github.com/redcpp</a
            >
          </p>
          <p>
            LinkedIn: <a
              href="https://linkedin.com/in/redcpp"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent"
              >linkedin.com/in/redcpp</a
            >
          </p>
        </div>
        <div class="shrink-0 self-start [zoom:0.66]">
          <ToptalBadge />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Contact from '@/components/Contact.astro';
import PostItem from '@/components/PostItem.astro';
import { getPosts, localizePath, ogImagePath, UI, type Lang } from '@/i18n';
import { HOME } from '@/i18n/home';
import { person, website } from '@/lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const home = HOME[lang];
const latest = (await getPosts(lang)).slice(0, 3);

const group = 'border-t border-rule pt-10 mt-12';
const heading = 'text-[22px] font-bold';
const credential =
  'text-ink/80 underline underline-offset-4 decoration-rule hover:text-accent hover:decoration-accent transition-colors';
const more =
  'inline-block font-mono text-[14px] text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent';
---

<BaseLayout
  title={home.meta.title}
  description={home.meta.description}
  ogImage={ogImagePath('index', lang)}
  jsonLd={[person(), website(lang)]}
  lang={lang}
  alternates={{ es: '/', en: '/en/' }}
>
  <div class="max-w-[680px] mx-auto px-6 pt-12 pb-16 lg:pt-20">
    <header>
      <h1 class="text-[34px] lg:text-[40px] font-bold tracking-tight leading-tight">Diego Said</h1>
      <p class="mt-4 text-[19px] leading-[1.6] text-ink/85">{home.tagline}</p>
      {/* One per line on a phone, a dotted row from sm up (see .credentials). */}
      <ul class="credentials mt-5 font-mono text-[13px]">
        {
          home.credentials.map(({ label, href }) => (
            <li>
              {href.startsWith('/') ? (
                <a href={localizePath(href, lang)} class={credential}>
                  {label}
                </a>
              ) : (
                <a href={href} target="_blank" rel="noopener noreferrer" class={credential}>
                  {label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-3 font-mono text-[13px] text-muted">{home.location}</p>
    </header>

    <section class={group} aria-labelledby="now">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="now" class={heading}>{home.headings.now}</h2>
        <span class="font-mono text-[13px] text-muted">{home.nowUpdated}</span>
      </div>
      <ul class="mt-5 space-y-3 list-disc pl-5 marker:text-accent">
        {home.now.map((item) => <li class="text-[17px] leading-[1.65]">{item}</li>)}
      </ul>
    </section>

    <section class={group} aria-labelledby="latest">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="latest" class={heading}>{t.latestWriting}</h2>
        <a
          href={localizePath('/rss.xml', lang)}
          class="font-mono text-[13px] text-muted hover:text-accent transition-colors"
        >
          {t.rss}
        </a>
      </div>
      <ol class="mt-2 divide-y divide-rule">
        {
          latest.map((post) => (
            <li>
              <PostItem post={post} lang={lang} />
            </li>
          ))
        }
      </ol>
      <a href={localizePath('/blog/', lang)} class={more}>{t.seeAllWriting}</a>
    </section>

    <section class={group} aria-labelledby="work">
      <h2 id="work" class={heading}>{home.headings.work}</h2>
      <p class="mt-4 text-[17px] leading-[1.7]">{home.work}</p>
      <a href={localizePath('/cv/', lang)} class={`${more} mt-3`}>{home.workLink}</a>
    </section>

    <div class={group}>
      <Contact lang={lang} />
    </div>
  </div>
</BaseLayout>

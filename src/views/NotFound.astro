---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizePath, UI, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
---

<BaseLayout title={`${t.notFound} — Diego Said`} description={t.notFoundBody} lang={lang}>
  <div class="max-w-[680px] mx-auto px-6 pt-12 pb-16 lg:pt-20">
    <p class="text-[13px] font-mono text-muted">404</p>
    <h1 class="text-[28px] lg:text-[32px] font-bold tracking-tight mt-3">{t.notFound}</h1>
    <p class="mt-3 text-[17px] text-muted leading-relaxed">
      {t.notFoundBody}
    </p>
    <div class="mt-12 border-t border-rule pt-8 flex items-center gap-6">
      <a
        href={localizePath('/', lang)}
        class="text-[14px] font-mono text-muted hover:text-accent transition-colors"
      >
        {t.home}
      </a>
      <a
        href={localizePath('/blog/', lang)}
        class="text-[14px] font-mono text-muted hover:text-accent transition-colors"
      >
        {t.writing}
      </a>
    </div>
  </div>
</BaseLayout>
